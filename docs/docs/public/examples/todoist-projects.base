filters:
  and:
    - 'note["task id"] != null'
    - 'file.path.endsWith(".task.md")'
    - 'note["status"] != "out_of_scope"'

properties:
  note.priority:
    displayName: "Priority"
  note.due date:
    displayName: "Due"
  note.deadline:
    displayName: "Deadline"
  note.labels:
    displayName: "Labels"

views:
  - type: tasks-list
    name: "Tasks List"
    # Set this to a Todoist project ID through Configure view > Project scope.
    # Leave it absent to show all synchronized projects.
    # Configure view > Project overview > Completion activity date.
    # "completed-date" is Completion date (default).
    # "deadline-first" is Deadline date, then completion date.
    tasksProjectOverviewCompletionDate: completed-date
    todoistDensity: comfortable
    todoistShowDescriptions: true
    todoistShowSections: true
    order:
      - note.priority
      - note.due date
      - note.deadline
      - note.labels
